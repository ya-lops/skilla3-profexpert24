---
import type { BrandData } from "@/types/brand";
import CtaCall from "../blocks/CtaCall.astro";

interface Props {
  brandData: BrandData;
  type: "column" | "grid";
}

const { brandData, type = "column" } = Astro.props;

const stepsImages = [
  {
    title: "Просто звоните и заказывайте",
    description: "Мы рассчитаем вам точную стоимость услуг",
    image: "/images/how-1.webp",
  },
  {
    title: "Рабочие приезжают точно вовремя",
    description: "Трезые, вежливые граждане РФ ",
    image: "/images/how-2.webp",
  },
  {
    title: "Выполняем свою работу",
    description: "Быстро, аккуратно и качественно",
    image: "/images/how-3.webp",
  },
  {
    title: "Вы получаете документы",
    description: "Все необходимые бухгалтерские документы",
    image: "/images/how-4.webp",
  },
];
---

<section class="py-8 md:py-10 lg:py-25 overflow-clip" data-cmp="HowWeWork">
  <div class="container">
    <h2 class="typo-h2 pb-15 lg:pb-30">Как мы работаем</h2>

    {
      type == "column" && (
        <div class="flex flex-col gap-10 max-w-240 mx-auto">
          {stepsImages.map((step: any, index: number) => {
            const isEven = index % 2 === 1;

            return (
              <div class={`_step flex max-md:flex-col gap-10 md:gap-25 w-full ${isEven ? "ml-auto flex-row-reverse" : ""}`}>
                <div class="flex flex-1 items-center gap-12">
                  <div class={`text-text-primary typo-h3`}>{index + 1}.</div>
                  <h3 class="typo-h6 text-balance">{step.title}</h3>
                </div>

                <div class="flex-1 shrink-0 relative grid place-items-center w-[min(27rem,100%)] justify-center aspect-430/230">
                  <img class={`absolute h-max max-h-[120%] pointer-events-none`} src={step.image} alt="" loading="lazy" />
                </div>
              </div>
            );
          })}
        </div>
      )
    }

    {
      type == "grid" && (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-15 lg:gap-25">
          {stepsImages.map((step: any, index: number) => {
            return (
              <div class={`_step flex flex-col gap-7`}>
                <div class="flex justify-center items-end aspect-650/300 max-h-[300px] add-clip-rect-br before:bg-[#EDF1F8]">
                  <img class={`max-h-[130%] pointer-events-none pb-7`} src={step.image} alt="" loading="lazy" />
                </div>
                <div class={`text-text-secondary typo-h5`}>{index + 1}.</div>
                <h3 class="typo-h4">{step.title}</h3>
                <p class="text-balance">{step.description}</p>
              </div>
            );
          })}
        </div>
      )
    }

    <div class="mt-10 lg:mt-20">
      <CtaCall {brandData} />
    </div>
  </div>
</section>
