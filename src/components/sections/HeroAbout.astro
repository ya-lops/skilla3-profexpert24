---
import type { BrandData } from "@/types/brand";

import Button from "../ui/Button.astro";

interface Props {
  brandData: BrandData;
}

const { brandData } = Astro.props;

const firstServiceUrl = brandData.services[0].url.toLowerCase();
---

<section
  class="hero grid grid-cols-[100%] min-h-[510px] md:min-h-[700px] mt-[-120px] pt-[110px] lg:mt-[-110px] lg:pt-[120px] bg-accent overflow-clip"
  data-cmp="HeroAbout"
>
  <div class="container h-full isolate">
    <div class="grid grid-cols-1 h-full items-center">
      <div class="relative z-1 flex flex-col gap-7 lg:gap-10 py-7 lg:py-14">
        <h1 class="flex flex-col typo-h1 my-auto">
          <span class="text-text-primary-inverse text-balance">Более 25 000<br>заказов с 2010 года</span>
        </h1>
        <div class="mt-18">
          <Button href={`/${firstServiceUrl}`} variant="primary" text="Наши услуги" />
        </div>
      </div>
    </div>
  </div>
</section>
